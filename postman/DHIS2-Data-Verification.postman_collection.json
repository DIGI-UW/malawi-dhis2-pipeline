    },
    {
      "name": "3c. Sample Combo: All+FNP",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValues?dataElement={{data_element_id}}&period={{period}}&categoryOptionCombo=D2UhDW2YmrY&paging=false",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValues"],
          "query": [
            { "key": "dataElement", "value": "{{data_element_id}}" },
            { "key": "period", "value": "{{period}}" },
            { "key": "categoryOptionCombo", "value": "D2UhDW2YmrY" },
