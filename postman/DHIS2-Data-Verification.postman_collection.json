          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "var count = jsonData.dataValues ? jsonData.dataValues.length : 0;",
              "",
              "pm.test('All+FNP (D2UhDW2YmrY): ' + count + ' values', function () {",
              "    pm.expect(count).to.be.above(0);",
              "});",
              "",
              "if (count > 0) {",
              "    console.log('✓ Found', count, 'values for All+FNP');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Validate Category Combo Structure",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/categoryOptionCombos/yIQ4kpNaYYw?fields=id,name,categoryOptions[id,name,code]",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "categoryOptionCombos", "yIQ4kpNaYYw"],
          "query": [
            { "key": "fields", "value": "id,name,categoryOptions[id,name,code]" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category combo exists', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "var options = jsonData.categoryOptions || [];",
              "",
              "pm.test('Category combo has 2 options (sex + age)', function () {",
              "    pm.expect(options.length).to.equal(2);",
              "});",
              "",
              "if (options.length > 0) {",
              "    console.log('✓ Category combo:', jsonData.name);",
              "    console.log('✓ Category options:');",
              "    options.forEach(opt => {",
              "        console.log('  -', opt.name, '(' + opt.code + ')');",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Check for Default Combo Usage",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValues?dataElement={{data_element_id}}&period={{period}}&categoryOptionCombo=HllvX50cXC0&paging=false",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValues"],
          "query": [
            { "key": "dataElement", "value": "{{data_element_id}}" },
            { "key": "period", "value": "{{period}}" },
            { "key": "categoryOptionCombo", "value": "HllvX50cXC0" },
            { "key": "paging", "value": "false" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "var count = jsonData.dataValues ? jsonData.dataValues.length : 0;",
              "",
              "pm.test('No default combo usage (proper disaggregation)', function () {",
              "    pm.expect(count).to.equal(0);",
              "});",
              "",
              "if (count === 0) {",
              "    console.log('✓ No default combo usage - all data is properly disaggregated');",
              "} else {",
              "    console.log('✗ Found', count, 'values using default combo (missing disaggregation)');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Check Sample Facility",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValues?dataElement={{data_element_id}}&period={{period}}&orgUnit={{sample_org_unit}}&paging=false",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValues"],
          "query": [
            { "key": "dataElement", "value": "{{data_element_id}}" },
            { "key": "period", "value": "{{period}}" },
            { "key": "orgUnit", "value": "{{sample_org_unit}}" },
            { "key": "paging", "value": "false" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "var count = jsonData.dataValues ? jsonData.dataValues.length : 0;",
              "",
              "pm.test('Kamuzu Academy Clinic has data', function () {",
              "    pm.expect(count).to.be.above(0);",
              "});",
              "",
              "if (count > 0) {",
              "    console.log('✓ Kamuzu Academy Clinic:', count, 'values');",
              "    ",
              "    // Show disaggregation for this facility",
              "    var combos = new Set(jsonData.dataValues.map(v => v.categoryOptionCombo));",
              "    console.log('✓ Disaggregated across', combos.size, 'category combos');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Check for Duplicates",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValues?dataElement={{data_element_id}}&period={{period}}&paging=false",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValues"],
          "query": [
            { "key": "dataElement", "value": "{{data_element_id}}" },
            { "key": "period", "value": "{{period}}" },
            { "key": "paging", "value": "false" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "var dataValues = jsonData.dataValues || [];",
              "",
              "// Check for duplicates by creating unique keys",
              "var seen = {};",
              "var duplicates = [];",
              "",
              "dataValues.forEach(v => {",
              "    var key = v.orgUnit + '+' + v.categoryOptionCombo + '+' + v.period;",
              "    if (seen[key]) {",
              "        duplicates.push(key);",
              "    }",
              "    seen[key] = true;",
              "});",
              "",
              "pm.test('No duplicate data values', function () {",
              "    pm.expect(duplicates.length).to.equal(0);",
              "});",
              "",
              "if (duplicates.length === 0) {",
              "    console.log('✓ No duplicate data values found');",
              "} else {",
              "    console.log('✗ Found', duplicates.length, 'duplicate combinations');",
              "    console.log('Sample duplicates:', duplicates.slice(0, 3));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Value Distribution Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValues?dataElement={{data_element_id}}&period={{period}}&paging=false",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValues"],
          "query": [
            { "key": "dataElement", "value": "{{data_element_id}}" },
            { "key": "period", "value": "{{period}}" },
            { "key": "paging", "value": "false" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "var dataValues = jsonData.dataValues || [];",
              "",
              "if (dataValues.length > 0) {",
              "    var values = dataValues.map(v => parseFloat(v.value));",
              "    var sum = values.reduce((a, b) => a + b, 0);",
              "    var min = Math.min(...values);",
              "    var max = Math.max(...values);",
              "    var avg = sum / values.length;",
              "    ",
              "    console.log('✓ Value Statistics:');",
              "    console.log('  - Count:', values.length);",
              "    console.log('  - Sum:', sum);",
              "    console.log('  - Min:', min);",
              "    console.log('  - Max:', max);",
              "    console.log('  - Avg:', avg.toFixed(2));",
              "    ",
              "    pm.test('All values are numeric and positive', function () {",
              "        pm.expect(min).to.be.at.least(0);",
              "    });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}

