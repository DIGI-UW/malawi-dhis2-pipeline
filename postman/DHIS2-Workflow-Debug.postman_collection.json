    {
      "name": "5b. Get Data Element (TX_CURR) ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataElements?filter=code:eq:TX_CURR&fields=id",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataElements"],
          "query": [
            { "key": "filter", "value": "code:eq:TX_CURR" },
            { "key": "fields", "value": "id" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
