          "raw": "{\n  \"dataValues\": [\n    {\n      \"dataElement\": \"{{data_element_id}}\",\n      \"period\": \"202508\",\n      \"orgUnit\": \"{{facility_org_unit_id}}\",\n      \"categoryOptionCombo\": \"HllvX50cXC0\",\n      \"value\": \"43\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValueSets?importStrategy=CREATE_AND_UPDATE&skipExistingCheck=true",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValueSets"],
          "query": [
            {
              "key": "importStrategy",
