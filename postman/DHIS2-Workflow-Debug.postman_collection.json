          "raw": "{\n  \"name\": \"Malawi ART Data Set\",\n  \"shortName\": \"ART Data Set\",\n  \"code\": \"MALAWI_ART_DATASET\",\n  \"periodType\": \"Quarterly\",\n  \"dataSetElements\": [\n    {\n      \"dataElement\": {\"id\": \"{{data_element_id}}\"}\n    }\n  ],\n  \"organisationUnits\": [\n    {\"id\": \"{{country_org_unit_id}}\"},\n    {\"id\": \"{{facility_org_unit_id}}\"}\n  ]\n}"
