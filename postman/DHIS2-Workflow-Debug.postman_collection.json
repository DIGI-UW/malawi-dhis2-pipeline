        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Facility\",\n  \"shortName\": \"Test Facility\",\n  \"code\": \"TEST_FACILITY\",\n  \"openingDate\": \"2020-01-01\",\n  \"parent\": { \"id\": \"{{country_org_unit_id}}\" }\n}"
