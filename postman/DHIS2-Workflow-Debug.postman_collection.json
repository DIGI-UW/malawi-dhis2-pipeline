    {
      "name": "9. Test Upload with Integration User (CODE/NAME scheme)",
      "request": {
        "method": "POST", 
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataValues\": [\n    {\n      \"dataElement\": \"TX_CURR\",\n      \"period\": \"202508\",\n      \"orgUnit\": \"Test Facility\",\n      \"categoryOptionCombo\": \"HllvX50cXC0\",\n      \"value\": \"42\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{dhis2_base_url}}/api/dataValueSets?importStrategy=CREATE_AND_UPDATE&skipExistingCheck=true&dataElementIdScheme=CODE&orgUnitIdScheme=NAME",
          "host": ["{{dhis2_base_url}}"],
          "path": ["api", "dataValueSets"],
          "query": [
            {
              "key": "importStrategy",
              "value": "CREATE_AND_UPDATE"
            },
            {
              "key": "skipExistingCheck",
              "value": "true"
