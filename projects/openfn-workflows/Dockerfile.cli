# Multi-stage build: Custom SFTP adaptor + CLI environment
FROM node:18-alpine AS adaptor-builder

# Install pnpm for building OpenFN adaptors
RUN npm install -g pnpm

# Set working directory for adaptor build
WORKDIR /build

    # Copy our custom adaptors project
    COPY openfn-adaptors/ ./

# Install dependencies and build only the SFTP adaptor
RUN pnpm install
RUN cd packages/sftp && pnpm build

# Main CLI testing stage
FROM node:18-alpine

# Install dependencies for building and debugging
RUN apk add --no-cache \
    bash \
    curl \
    jq \
    git \
    openssh-client

# Set working directory
WORKDIR /workspace

# Install OpenFN CLI globally
RUN npm install -g @openfn/cli@latest

# Install adaptors with fixed dependencies (excluding SFTP - we'll use custom)
RUN mkdir -p /adaptors && cd /adaptors && \
    npm init -y && \
    npm install @openfn/language-http@6.4.5 @openfn/language-common@2.5.0

# Copy and install our custom SFTP adaptor with fixed dependencies
COPY --from=adaptor-builder /build/packages/sftp/ /adaptors/custom-sftp/
RUN cd /adaptors/custom-sftp && \
    rm -rf node_modules package-lock.json && \
    sed -i 's/"@openfn\/language-common": "workspace:\*"/"@openfn\/language-common": "^2.5.0"/' package.json && \
    npm install --omit=dev

# Create symlink so CLI can find our custom SFTP adaptor
RUN cd /adaptors && \
    ln -sf /adaptors/custom-sftp node_modules/@openfn/language-sftp

# Set adaptor path for OpenFN CLI and Node module resolution
ENV OPENFN_MODULES_HOME=/adaptors/node_modules
ENV NODE_PATH=/adaptors/node_modules
ENV OPENFN_REPO_DIR=/tmp/openfn/repo

# Pre-install our custom SFTP adaptor in the CLI's repo location
# First restore the custom version tag
RUN cd /adaptors/custom-sftp && \
    sed -i 's/"version": "[^"]*"/"version": "2.0.14-custom"/' package.json

# Then install it in the CLI's expected location
RUN mkdir -p /tmp/openfn/repo/node_modules/@openfn && \
    cp -r /adaptors/custom-sftp "/tmp/openfn/repo/node_modules/@openfn/language-sftp_2.0.14-custom" && \
    cd /tmp/openfn/repo && \
    echo '{"name":"openfn-repo","version":"1.0.0","dependencies":{"@openfn/language-sftp_2.0.14-custom":"npm:@openfn/language-sftp@2.0.14-custom"}}' > package.json

# Create symlink from default repo location to our custom repo
RUN ln -sf /tmp/openfn/repo /tmp/repo

# Create helper scripts
RUN echo '#!/bin/bash' > /usr/local/bin/test-sftp && \
    echo 'openfn test "$@" -l debug --no-expand-references' >> /usr/local/bin/test-sftp && \
    chmod +x /usr/local/bin/test-sftp

RUN echo '#!/bin/bash' > /usr/local/bin/run-workflow && \
    echo 'openfn run "$@" -l debug --no-expand-references' >> /usr/local/bin/run-workflow && \
    chmod +x /usr/local/bin/run-workflow

# Default command
CMD ["bash"] 