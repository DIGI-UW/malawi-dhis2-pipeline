{
  "name": "malawi-openfn-workflows",
  "version": "1.0.0",
  "description": "OpenFN workflows for Malawi DHIS2 HIV/TB indicators pipeline",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:cli",
    "test:unit": "docker compose -f docker-compose.test.yml run --rm cli-test mocha tests/unit/**/*.test.js",
    "test:cli": "docker compose -f docker-compose.test.yml run --rm cli-test test-sftp tests/e2e/sftp-check-input.json",
    "test:cli:build": "docker compose -f docker-compose.test.yml build cli-test",
    "test:openfn": "node tests/e2e/trigger-workflow.js",
    "dev": "docker compose -f docker-compose.test.yml run --rm cli-test run-workflow tests/e2e/sftp-check-input.json",
    "dev:shell": "docker compose -f docker-compose.test.yml run --rm cli-test bash",
    "dev:up": "docker compose -f docker-compose.test.yml up -d cli-test",
    "dev:down": "docker compose -f docker-compose.test.yml down",
    "dev:logs": "docker logs -f $(docker ps -q -f ancestor=openfn-custom:latest) | grep -E '(SFTP|Connected|Error)'",
    "test:data": "docker compose -f docker-compose.test.yml run --rm test-data",
    "deploy": "echo 'Workflows auto-loaded by OpenFN on startup'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:jobs": "./scripts/test-jobs.sh",
    "test:workflows": "./scripts/test-workflows.sh",
    "validate": "./scripts/validate-workflows.sh",
    "lint": "./scripts/lint-jobs.sh",
    "build": "docker build -f Dockerfile.test -t openfn-workflows-test .",
    "cli": "docker run -it --rm -v $(pwd):/app openfn-workflows-test openfn"
  },
  "dependencies": {
    "@openfn/language-common": "^2.4.0",
    "@openfn/language-sftp": "^1.0.0",
    "@openfn/language-dhis2": "^6.3.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.5",
    "nodemon": "^3.0.1",
    "@openfn/cli": "^1.8.5",
    "@openfn/language-http": "^6.4.5",
    "mocha": "^10.2.0",
    "chai": "^4.3.10"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "workflows/**/*.js",
      "!workflows/**/node_modules/**"
    ]
  },
  "keywords": [
    "openfn",
    "dhis2",
    "malawi",
    "hiv",
    "tb",
    "indicators"
  ],
  "author": "Malawi DHIS2 Pipeline Team",
  "license": "MIT"
} 